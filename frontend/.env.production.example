# Copy this file to `.env.production` (or set in Vercel dashboard
# under Project Settings > Environment Variables) before building.
#
# Prefer the same origin and leave this variable unset when the frontend is
# served behind the backend/reverse proxy. Otherwise point it at your own API.
# No trailing slash. The /api suffix is required.

VITE_API_URL=https://api.example.com/api
